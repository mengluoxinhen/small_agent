# Copy to .env and fill in. Never commit .env.

# --- Model (any OpenAI-compatible endpoint; default: Aliyun DashScope) ---
LLM_API_KEY=sk-replace-me
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
# DeepSeek works the same way: base_url=https://api.deepseek.com, model=deepseek-chat

# openai = call the real API | fake = deterministic in-process model (no key needed)
MODEL_BACKEND=openai

# --- Agent behaviour ---
# review      = low-risk tools auto-approved, write/dangerous pause for confirmation
# full_access = every tool executes immediately, never pauses
DEFAULT_MODE=review
MAX_TURNS=25

# --- Storage ---
# SQLite files live under DATA_DIR: small_dify.db (human-facing trace)
# + sdk_memory.db (model-facing memory), plus workspaces/<session-id>/.
DATA_DIR=./data
LOG_LEVEL=INFO
