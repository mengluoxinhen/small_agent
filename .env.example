# Copy to .env and fill in. Never commit .env.

# --- Model (DeepSeek, OpenAI-compatible) ---
LLM_API_KEY=sk-replace-me
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# openai = call the real API | fake = deterministic in-process model (no key needed)
MODEL_BACKEND=openai

# --- Agent behaviour ---
# review      = low-risk tools auto-approved, write/dangerous pause for confirmation
# full_access = every tool executes immediately, never pauses
DEFAULT_MODE=review
MAX_TURNS=25

# --- Storage ---
DATA_DIR=./data
LOG_LEVEL=INFO
